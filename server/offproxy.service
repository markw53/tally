[Unit]
Description=offproxy — Open Food Facts front-end for Tally
Documentation=https://openfoodfacts.github.io/openfoodfacts-server/api/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=offproxy
Group=offproxy
ExecStart=/usr/local/bin/offproxy
Restart=on-failure
RestartSec=3s

# --- edit these two, or override with: systemctl edit offproxy ---
# Use a real contact address: it is how Open Food Facts reaches you if the
# client misbehaves, and the service refuses to start without it.
#
# The quotes matter. systemd splits Environment= on whitespace, so an unquoted
# value would set OFFPROXY_UA=Tally/1.1 and silently discard the address.
Environment="OFFPROXY_UA=Tally/1.1 (you@example.com)"
#
# Scheme and host only, no path and no trailing slash — this is matched against
# the browser's Origin header, which never includes a path. For GitHub Pages
# that means https://you.github.io, NOT https://you.github.io/tally/
Environment="OFFPROXY_ORIGINS=https://you.github.io"
Environment="OFFPROXY_ADDR=127.0.0.1:8080"

# --- optional: diary sync for one or more people ---
#
#   ⚠  DO NOT put real tokens in this file while it lives in your git repo.
#      A GitHub Pages repo is public, so committing them publishes them.
#      Fill them in on the SERVER copy instead:
#          sudo systemctl edit --full offproxy
#      which edits /etc/systemd/system/offproxy.service — outside the repo.
#
# Leave both unset and offproxy stays a stateless search service.
# Set both to enable sync. Generate each token with:  offproxy -gen-token
# The account name is only a folder name; the token is what authenticates.
#Environment="OFFPROXY_DATA=/var/lib/offproxy"
#Environment="OFFPROXY_ACCOUNTS=mark:PASTE_TOKEN_HERE,claire:PASTE_OTHER_TOKEN_HERE"

# StateDirectory creates /var/lib/offproxy owned by this service and, crucially,
# makes it writable despite ProtectSystem=strict below. Without it, sync writes
# fail with a permission error that looks like a bug in the app.
StateDirectory=offproxy
StateDirectoryMode=0700
UMask=0077

# --- hardening: it makes outbound HTTPS calls and nothing else ---
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
